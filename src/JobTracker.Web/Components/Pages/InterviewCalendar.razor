@page "/calendar"
@using JobTracker.Core.Calendar
@using JobTracker.Core.Entities
@using JobTracker.Core.Enums
@using JobTracker.Web.Components.Interviews
@implements IAsyncDisposable
@inject IInterviewService Interviews
@inject IApplicationDataSource Applications
@inject IDialogService Dialogs
@inject IJSRuntime JS
@inject ILogger<InterviewCalendar> Logger

<PageTitle>Interview calendar · Grad Job Tracker</PageTitle>

<MudText Typo="Typo.h4">Interview calendar</MudText>
<MudText Class="mb-4">Plan your interviews in Sydney time (AEST/AEDT).</MudText>
<MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mb-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => OpenAsync()" Disabled="_loading">Add interview</MudButton>
    <MudButton Variant="Variant.Outlined" OnClick="ExportAsync" Disabled="@(_loading || _exporting || _interviews.Count == 0 || _error is not null)">Export month (.ics)</MudButton>
    <MudButton OnClick="LoadAsync" Disabled="_loading">Refresh</MudButton>
</MudStack>
<MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
    <MudButton OnClick="() => MoveMonthAsync(-1)" Disabled="@(_loading || _month.Year <= 1900)">Previous month</MudButton>
    <MudText Typo="Typo.h5">@_month.ToString("MMMM yyyy")</MudText>
    <MudButton OnClick="TodayAsync" Disabled="_loading">Today</MudButton>
    <MudButton OnClick="() => MoveMonthAsync(1)" Disabled="@(_loading || _month.Year >= 9998)">Next month</MudButton>
</MudStack>
@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Class="mb-3" />
}
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
}
@if (!_loading && _error is null)
{
    @if (_interviews.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-3">No interviews this month. Select a day to schedule one.</MudAlert>
    }
    <div class="interview-calendar-scroll">
        <div class="interview-calendar" aria-label="Interview month calendar">
            @foreach (var weekday in Weekdays)
            {
                <div class="calendar-weekday">@weekday</div>
            }
            @for (int index = 0; index < LeadingDays; index++)
            {
                <div class="calendar-day calendar-padding" aria-hidden="true"></div>
            }
            @for (int day = 1; day <= DateTime.DaysInMonth(_month.Year, _month.Month); day++)
            {
                var date = _month.AddDays(day - 1);
                <div class="calendar-day @(date == SydneyTime.FromUtc(DateTime.UtcNow).Date ? "calendar-today" : "")">
                    <button class="calendar-day-button" aria-label="@($"Add interview on {date:dddd d MMMM yyyy}")" @onclick="() => OpenAsync(date)">@day <span aria-hidden="true">+</span></button>
                    @foreach (var interview in _interviews.Where(item => SydneyTime.FromUtc(item.ScheduledAt).Date == date))
                    {
                        <button class="calendar-event @(interview.Outcome == InterviewOutcome.Cancelled ? "calendar-cancelled" : "")"
                                @onclick="() => OpenAsync(date, interview.Id)">
                            <strong>@SydneyTime.FromUtc(interview.ScheduledAt).ToString("HH:mm") · @interview.Type.ToDisplayText()</strong>
                            <span>@ApplicationLabel(interview.ApplicationId)</span>
                            <span>@interview.Outcome · @interview.DurationMinutes min</span>
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private static readonly string[] Weekdays = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    private DateTime _month = MonthOf(SydneyTime.FromUtc(DateTime.UtcNow));
    private IReadOnlyList<Interview> _interviews = Array.Empty<Interview>();
    private Dictionary<int, string> _applicationLabels = new();
    private bool _loading, _exporting;
    private string? _error;
    private IJSObjectReference? _downloadModule;
    private int LeadingDays => ((int)_month.DayOfWeek + 6) % 7;

    /// <inheritdoc />
    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _interviews = await Interviews.GetByDateRangeAsync(SydneyTime.ToUtc(_month), SydneyTime.ToUtc(_month.AddMonths(1)));
            _applicationLabels = (await Applications.GetApplicationsAsync()).ToDictionary(item => item.Id,
                item => $"{item.CompanyName} · {item.RoleTitle}");
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not load interview calendar");
            _interviews = Array.Empty<Interview>();
            _error = "Could not load the calendar. Please select Refresh to try again.";
        }
        finally { _loading = false; }
    }

    private async Task OpenAsync(DateTime? date = null, int? interviewId = null)
    {
        var parameters = new DialogParameters<InterviewDialog>
        {
            { dialog => dialog.InitialDate, date ?? SydneyTime.FromUtc(DateTime.UtcNow).Date },
            { dialog => dialog.InterviewId, interviewId }
        };
        var dialog = await Dialogs.ShowAsync<InterviewDialog>(interviewId.HasValue ? "Edit interview" : "Add interview",
            parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small, BackdropClick = false });
        if (await dialog.Result is { Canceled: false }) await LoadAsync();
    }

    private async Task MoveMonthAsync(int offset)
    {
        _month = _month.AddMonths(offset);
        await LoadAsync();
    }

    private async Task TodayAsync()
    {
        _month = MonthOf(SydneyTime.FromUtc(DateTime.UtcNow));
        await LoadAsync();
    }

    private async Task ExportAsync()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            var content = InterviewCalendarExport.Create(_interviews, ApplicationLabel, DateTime.UtcNow);
            _downloadModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./interviewCalendar.js");
            await _downloadModule.InvokeVoidAsync("downloadCalendar", $"interviews-{_month:yyyy-MM}.ics", content);
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Could not export calendar");
            _error = "Could not export interviews. Refresh the calendar and try again.";
        }
        finally { _exporting = false; }
    }

    private string ApplicationLabel(int id) => _applicationLabels.GetValueOrDefault(id, $"Application #{id}");
    private static DateTime MonthOf(DateTime date) => new(date.Year, date.Month, 1);

    /// <summary>Releases the browser download module when leaving the page.</summary>
    public async ValueTask DisposeAsync()
    {
        if (_downloadModule is not null)
        {
            try { await _downloadModule.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}
