@* Owner: Sarah (S1). Add or edit an application. The same dialog is used for both: pass ApplicationId to edit. *@
@using System.ComponentModel.DataAnnotations
@using JobTracker.Core.Entities
@using JobTracker.Core.Enums
@using JobTracker.Core.Extensions
@inject IApplicationService ApplicationService

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
        }
        else
        {
            <EditForm Model="_model" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />

                @if (_error != null)
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3" ShowCloseIcon="true" CloseIconClicked="() => _error = null">@_error</MudAlert>
                }

                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudAutocomplete T="string" Label="Company *" @bind-Value="_companyName"
                                         SearchFunc="SearchCompaniesAsync" CoerceValue="true" ResetValueOnEmptyText="true"
                                         MaxItems="10" Error="_companyError != null" ErrorText="@_companyError"
                                         HelperText="Pick a company or type a new one" Immediate="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField Label="Role *" @bind-Value="_model.RoleTitle" For="@(() => _model.RoleTitle)" />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudTextField Label="Location *" @bind-Value="_model.Location" For="@(() => _model.Location)"
                                      Placeholder="e.g. Sydney or Remote" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="WorkMode" Label="Work mode" @bind-Value="_model.WorkMode">
                            @foreach (WorkMode workMode in Enum.GetValues<WorkMode>())
                            {
                                <MudSelectItem Value="workMode">@workMode.ToDisplayText()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudSelect T="ApplicationSource" Label="Source" @bind-Value="_model.Source">
                            @foreach (ApplicationSource source in Enum.GetValues<ApplicationSource>())
                            {
                                <MudSelectItem Value="source">@source.ToDisplayText()</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    @if (IsNew)
                    {
                        <MudItem xs="12" sm="4">
                            <MudSelect T="ApplicationStatus" Label="Starting status" Value="_model.Status" ValueChanged="OnStartingStatusChanged">
                                @foreach (ApplicationStatus status in StartingStatuses)
                                {
                                    <MudSelectItem Value="status">@status.ToDisplayText()</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12" sm="4">
                            <MudTextField Label="Status" Value="@_model.Status.ToDisplayText()" ReadOnly="true"
                                          HelperText="Change the status on the board" />
                        </MudItem>
                    }
                    <MudItem xs="12" sm="4">
                        <MudDatePicker Label="Date applied" @bind-Date="_model.DateApplied" For="@(() => _model.DateApplied)"
                                       MaxDate="DateTime.Today" Clearable="true" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudDatePicker Label="Date posted" @bind-Date="_model.DatePosted" For="@(() => _model.DatePosted)"
                                       MaxDate="DateTime.Today" Clearable="true" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?" Label="Salary min (AUD)" @bind-Value="_model.SalaryMin" For="@(() => _model.SalaryMin)"
                                         Min="0" Step="1000" HideSpinButtons="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?" Label="Salary max (AUD)" @bind-Value="_model.SalaryMax" For="@(() => _model.SalaryMax)"
                                         Min="0" Step="1000" HideSpinButtons="true" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField Label="Job ad link" @bind-Value="_model.JobUrl" For="@(() => _model.JobUrl)"
                                      Placeholder="https://" InputType="InputType.Url" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField Label="Job description" @bind-Value="_model.JobDescription" Lines="5"
                                      HelperText="Paste the job ad. Skills are picked out of it for the analytics." />
                    </MudItem>

                    <MudItem xs="12" sm="4">
                        <MudCheckBox T="bool" Label="Referral" @bind-Value="_model.HadReferral" Color="Color.Primary" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudCheckBox T="bool" Label="Tailored resume" @bind-Value="_model.TailoredResume" Color="Color.Primary" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudCheckBox T="bool" Label="Cover letter" @bind-Value="_model.WroteCoverLetter" Color="Color.Primary" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField Label="Notes" @bind-Value="_model.Notes" Lines="2" />
                    </MudItem>
                </MudGrid>

                <div class="d-flex justify-end gap-2 mt-4">
                    <MudButton Variant="Variant.Text" OnClick="Cancel" Disabled="_saving">Cancel</MudButton>
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_saving">
                        @(_saving ? "Saving…" : IsNew ? "Add application" : "Save changes")
                    </MudButton>
                </div>
            </EditForm>
        }
    </DialogContent>
</MudDialog>

@code {
    /// <summary>The application to edit, or null to add a new one.</summary>
    [Parameter]
    public int? ApplicationId { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Statuses a new application can start in: saved for later, or already somewhere in the pipeline.</summary>
    private static readonly ApplicationStatus[] StartingStatuses =
    {
        ApplicationStatus.Wishlist, ApplicationStatus.Applied, ApplicationStatus.Assessment,
        ApplicationStatus.Interview, ApplicationStatus.FinalRound, ApplicationStatus.Offer
    };

    private JobApplication _model = new JobApplication { Status = ApplicationStatus.Applied, DateApplied = DateTime.Today };
    private IReadOnlyList<string> _companyNames = Array.Empty<string>();
    private string? _companyName;
    private string? _companyError;
    private string? _error;
    private bool _loading = true;
    private bool _saving;

    private bool IsNew => ApplicationId is null;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _companyNames = await ApplicationService.GetCompanyNamesAsync();

            if (!IsNew)
            {
                JobApplication? existing = await ApplicationService.GetByIdAsync(ApplicationId!.Value);
                if (existing == null)
                {
                    _error = "This application no longer exists.";
                }
                else
                {
                    _model = existing;
                    _companyName = existing.Company?.Name;
                }
            }
        }
        catch (Exception ex)
        {
            _error = $"Could not load the form: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>Company names containing the typed text, for the autocomplete list.</summary>
    private Task<IEnumerable<string>> SearchCompaniesAsync(string? text, CancellationToken cancellationToken)
    {
        IEnumerable<string> matches = string.IsNullOrWhiteSpace(text)
            ? _companyNames
            : _companyNames.Where(name => name.Contains(text.Trim(), StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(matches);
    }

    /// <summary>A wishlist item has no applied date yet; any other starting status needs one, so default it to today.</summary>
    private void OnStartingStatusChanged(ApplicationStatus status)
    {
        _model.Status = status;
        if (status == ApplicationStatus.Wishlist)
        {
            _model.DateApplied = null;
        }
        else
        {
            _model.DateApplied ??= DateTime.Today;
        }
    }

    /// <summary>Runs after the field rules pass. The service checks everything again and creates the company if it is new.</summary>
    private async Task SaveAsync()
    {
        _error = null;
        _companyError = string.IsNullOrWhiteSpace(_companyName) ? "Company is required." : null;
        if (_companyError != null)
        {
            return;
        }

        _saving = true;
        try
        {
            if (IsNew)
            {
                JobApplication created = await ApplicationService.CreateAsync(_model, _companyName!);
                MudDialog.Close(DialogResult.Ok(created.Id));
            }
            else
            {
                await ApplicationService.UpdateAsync(_model, _companyName!);
                MudDialog.Close(DialogResult.Ok(_model.Id));
            }
        }
        catch (ValidationException ex)
        {
            _error = ex.Message;
        }
        catch (KeyNotFoundException)
        {
            _error = "This application was deleted by someone else, so it can't be saved.";
        }
        catch (Exception ex)
        {
            _error = $"Could not save: {ex.Message}";
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
