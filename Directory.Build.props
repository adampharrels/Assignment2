<Project>
  <!-- Shared settings for every project in the solution. -->
  <PropertyGroup>
    <!-- Lab machines: Visual Studio 2022 + .NET 9. Do NOT bump to net10.0. -->
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the app/tests run on a machine that only has a newer runtime (e.g. .NET 10 on a Mac). -->
    <RollForward>Major</RollForward>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
